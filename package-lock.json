{
  "name": "proofwire-monorepo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "proofwire-monorepo",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/core",
        "packages/proxy",
        "packages/cli",
        "packages/dashboard"
      ],
      "engines": {
        "node": ">=20.11"
      }
