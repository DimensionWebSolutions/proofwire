        "@proofwire/core": "0.1.0",
        "@proofwire/proxy": "0.1.0"
      },
      "bin": {
        "proofwire": "src/bin.js",
        "pw": "src/bin.js"
      },
      "engines": {
        "node": ">=20.11"
      }
    },
    "packages/core": {
      "name": "@proofwire/core",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=20.11"
      }
    },
    "packages/dashboard": {
      "name": "@proofwire/dashboard",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@proofwire/core": "0.1.0"
      },
      "engines": {
        "node": ">=20.11"
      }
    },
    "packages/proxy": {
      "name": "@proofwire/proxy",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@proofwire/core": "0.1.0"
      },
      "engines": {
        "node": ">=20.11"
      }
    }
